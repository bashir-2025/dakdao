# Copy to .env (or set in your hosting dashboard)
ADMIN_PASSWORD=change-this-to-a-strong-password
PORT=3000
# Set to 1 when the site runs behind HTTPS
COOKIE_SECURE=
# Set to 1 when behind a reverse proxy (Nginx, Render, Railway…) so rate limits use the real visitor IP
TRUST_PROXY=
# Turso database (leave empty to use the local data.db file)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
